FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHON=/usr/bin/python3
COPY package.json package-lock.json ./
COPY services/analytics-mcp/package.json ./services/analytics-mcp/package.json
COPY services/gateway/package.json ./services/gateway/package.json
COPY services/inventory-mcp/package.json ./services/inventory-mcp/package.json
COPY services/woo-mcp/package.json ./services/woo-mcp/package.json
COPY apps/dashboard/package.json ./apps/dashboard/package.json

RUN npm ci
COPY services ./services
COPY apps ./apps
COPY packages ./packages
COPY tsconfig.json ./tsconfig.json
RUN npm run build
RUN npm test
