FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHON=/usr/bin/python3
COPY package.json package-lock.json ./
COPY services/analytics-mcp/package.json ./services/analytics-mcp/package.json
COPY services/gateway/package.json ./services/gateway/package.json
COPY services/inventory-mcp/package.json ./services/inventory-mcp/package.json
COPY services/woo-mcp/package.json ./services/woo-mcp/package.json
COPY apps/dashboard/package.json ./apps/dashboard/package.json

RUN npm ci

COPY services ./services
COPY apps ./apps
COPY packages ./packages
COPY tsconfig.json ./tsconfig.json

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
ENV NODE_ENV=production

EXPOSE 3001 3002 3003 3004
CMD ["sh", "-c", "npm run start --workspace=\"$SERVICE_NAME\""]
